POSTGRES_DB=langame_bot
POSTGRES_USER=langame
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://langame:change_me@postgres:5432/langame_bot
LANGAME_BASE_URL=https://sa-vlg1.langame.ru/public_api
LANGAME_API_KEY=PUT_YOUR_KEY_HERE
TELEGRAM_BOT_TOKEN=PUT_YOUR_BOT_TOKEN_HERE
OWNER_TELEGRAM_IDS=123456789

# Mandatory safety setting: the bot never writes to LANGAME.
LANGAME_READ_ONLY=true

# Daily Owner report (local time)
REPORT_TIMEZONE=Europe/Moscow
REPORT_HOUR=9
REPORT_MINUTE=0

# Public HTTPS URL of the Telegram Mini App (leave empty to disable web app)
MINI_APP_URL=https://your-domain.example/
WEB_HOST=0.0.0.0
WEB_PORT=8000
